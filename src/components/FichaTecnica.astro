---
import type { CollectionEntry } from 'astro:content';
import Icon, { type IconName } from './Icon.astro';
import { labelCoord, parseCoord } from '../lib/torrente-helpers';
import { getDictionary } from '../i18n/ui';
import type { Locale } from '../i18n/config';

interface Props {
  data: CollectionEntry<'torrentes'>['data'];
  lang: Locale;
}

const { data, lang } = Astro.props;
const t = getDictionary(lang);

const specs: { icon: IconName; label: string; value: string }[] = [
  { icon: 'ruler', label: t.ficha.rapelMaximo, value: `${data.rapel_max} m` },
  { icon: 'rope', label: t.ficha.cuerdas, value: data.cuerdas_recomendadas },
  { icon: 'route', label: t.ficha.longitud, value: data.longitud_m ? `${data.longitud_m} m` : '—' },
  { icon: 'mountain', label: t.ficha.desnivel, value: data.desnivel_m ? `${data.desnivel_m} m` : '—' },
  { icon: 'drop', label: t.ficha.caudal, value: data.caudal },
  { icon: 'wave', label: t.ficha.neopreno, value: data.neopreno ?? '—' },
];

const tiempoRows: { icon: IconName; label: string; value: string | undefined }[] = [
  { icon: 'route', label: t.ficha.aproximacion, value: data.tiempos.aproximacion },
  { icon: 'rope', label: t.ficha.descenso, value: data.tiempos.descenso },
  { icon: 'compass', label: t.ficha.retorno, value: data.tiempos.retorno },
].filter((item) => item.value);

const coords = Object.entries(data.coordenadas).map(([key, value]) => ({
  key,
  label: t.coordLabels[key] ?? labelCoord(key),
  raw: value,
  parsed: parseCoord(value),
}));
---

<div class="grid gap-6 lg:grid-cols-3">
  <div class="rounded-2xl border border-brand-border bg-brand-surface p-5 lg:col-span-2">
    <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-400">
      <Icon name="layers" class="w-4 h-4 text-brand-cyan" />
      {t.ficha.title}
    </h2>
    <dl class="grid gap-4 sm:grid-cols-2">
      {specs.map((s) => (
        <div class="flex items-start gap-3 rounded-xl bg-brand-surface2/60 p-3">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-cyan/10 text-brand-cyan">
            <Icon name={s.icon} class="w-4 h-4" />
          </span>
          <div>
            <dt class="text-xs text-slate-500">{s.label}</dt>
            <dd class="text-sm font-medium text-slate-100">{s.value}</dd>
          </div>
        </div>
      ))}
    </dl>

    {data.regulacion_permisos && (
      <div class="mt-4 flex items-start gap-3 rounded-xl border border-brand-orange/30 bg-brand-orange/5 p-3.5">
        <Icon name="alert" class="mt-0.5 w-5 h-5 shrink-0 text-brand-orange" />
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-orange">{t.ficha.regulacion}</p>
          <p class="mt-1 text-sm text-slate-300">{data.regulacion_permisos}</p>
        </div>
      </div>
    )}
  </div>

  <div class="space-y-6">
    <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-400">
        <Icon name="clock" class="w-4 h-4 text-brand-cyan" />
        {t.ficha.tiempos}
      </h2>
      <ul class="space-y-2">
        {tiempoRows.map((item) => (
          <li class="rounded-lg bg-brand-surface2/60 px-3 py-2.5">
            <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-brand-cyan">
              <Icon name={item.icon} class="w-3.5 h-3.5 shrink-0" />
              {item.label}
            </div>
            <p class="mt-1 text-sm leading-snug text-slate-200 break-words">{item.value}</p>
          </li>
        ))}
      </ul>

      {data.tiempos.total && (
        <div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-brand-cyan/10 px-3 py-2.5 text-sm font-semibold text-brand-cyan">
          <span>{t.ficha.total}</span>
          <span class="text-right">{data.tiempos.total}</span>
        </div>
      )}
    </div>

    <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-400">
        <Icon name="map-pin" class="w-4 h-4 text-brand-cyan" />
        {t.ficha.coordenadas}
      </h2>
      <ul class="space-y-3" data-coord-list>
        {coords.map((c) => (
          <li class="rounded-lg bg-brand-surface2/60 p-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">{c.label}</p>
            <p class="mt-1 break-words font-mono text-sm text-slate-200">
              {c.parsed ? c.parsed.display : c.raw}
            </p>
            {c.parsed && (
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <a
                  href={c.parsed.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-md bg-brand-cyan/10 px-2 py-1 text-xs font-medium text-brand-cyan transition hover:bg-brand-cyan/20"
                >
                  <Icon name="external-link" class="w-3 h-3" />
                  {t.ficha.verMapa}
                </a>
                <button
                  type="button"
                  data-copy-coord
                  data-copy-value={c.parsed.copyValue}
                  data-copied-label={t.ficha.copiado}
                  class="inline-flex items-center gap-1 rounded-md border border-brand-border px-2 py-1 text-xs font-medium text-slate-300 transition hover:border-brand-cyan/40 hover:text-brand-cyan"
                >
                  <span data-icon-copy>
                    <Icon name="copy" class="w-3 h-3" />
                  </span>
                  <span data-icon-check class="hidden">
                    <Icon name="check" class="w-3 h-3 text-green-400" />
                  </span>
                  <span data-copy-label>{t.ficha.copiarCoords}</span>
                </button>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-coord]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.getAttribute('data-copy-value');
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        return;
      }

      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const iconCopy = btn.querySelector<HTMLElement>('[data-icon-copy]');
      const iconCheck = btn.querySelector<HTMLElement>('[data-icon-check]');
      const original = label?.textContent ?? '';
      const copied = btn.getAttribute('data-copied-label') ?? original;

      if (label) label.textContent = copied;
      iconCopy?.classList.add('hidden');
      iconCheck?.classList.remove('hidden');

      setTimeout(() => {
        if (label) label.textContent = original;
        iconCopy?.classList.remove('hidden');
        iconCheck?.classList.add('hidden');
      }, 1500);
    });
  });
</script>
