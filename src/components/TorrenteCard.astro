---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import { getTorrenteMedia } from '../lib/images';
import { extractGrade, gradeAccent, primaryZona } from '../lib/torrente-helpers';
import { getDictionary } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/config';

interface Props {
  torrente: CollectionEntry<'torrentes'>;
  lang: Locale;
}

const { torrente, lang } = Astro.props;
const { data } = torrente;
const t = getDictionary(lang);
const media = getTorrenteMedia(data.slug);
const grade = extractGrade(data.dificultad);
const accent = gradeAccent(data.dificultad);
const zona = primaryZona(data.zona);
const tagIcon: Record<string, 'drop' | 'rope' | 'sun' | 'star'> = { acuatico: 'drop', vertical: 'rope', verano: 'sun', coleccion: 'star' };
---

<a
  href={localizePath(`/torrentes/${data.slug}`, lang)}
  class="group block overflow-hidden rounded-2xl border border-brand-border bg-brand-surface shadow-card transition duration-300 hover:-translate-y-1 hover:border-brand-cyan/40 hover:shadow-glow"
  data-card
  data-zona={zona}
  data-grade={grade}
  data-caracter={data.tags.join(',')}
  data-search={`${data.nombre} ${data.zona} ${data.dificultad}`.toLowerCase()}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-surface2">
    {media.hero && (
      <Image
        src={media.hero}
        alt={`${data.nombre} — ${data.zona}`}
        width={640}
        height={480}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-brand-bg/10 to-transparent"></div>

    <span
      class:list={[
        'absolute right-3 top-3 rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wide backdrop-blur-sm ring-1 ring-inset',
        accent === 'danger' && 'bg-brand-danger/20 text-red-300 ring-red-400/40',
        accent === 'orange' && 'bg-brand-orange/20 text-orange-300 ring-brand-orange/40',
        accent === 'cyan' && 'bg-brand-cyan/20 text-cyan-200 ring-brand-cyan/40',
      ]}
    >
      {grade}
    </span>

    <div class="absolute bottom-3 left-3 right-3">
      <p class="text-xs font-medium uppercase tracking-wide text-brand-cyan">{zona}</p>
      <h3 class="font-display text-lg font-semibold text-white leading-tight">{data.nombre}</h3>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-1.5 p-4">
    <Badge icon="ruler" label={`${t.card.rapelMax} ${data.rapel_max}m`} tone="neutral" />
    <Badge icon="clock" label={data.tiempos.total ?? '—'} tone="neutral" />
    {data.tags.slice(0, 1).map((tag) => (
      <Badge icon={tagIcon[tag] ?? 'compass'} label={t.caracterTags[tag as keyof typeof t.caracterTags]} tone="cyan" />
    ))}
  </div>
</a>
