---
import Icon from './Icon.astro';
import { getDictionary } from '../i18n/ui';
import { localizePath, withBase, type Locale } from '../i18n/config';
import { INSTAGRAM_URL } from '../lib/contact';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-border/80 bg-brand-surface/40">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 text-slate-100">
          <img src={withBase('/logo.webp')} alt="Mallorca Canyons" class="h-8 w-8 rounded-full object-cover" />
          <span class="font-display text-base font-semibold uppercase tracking-wide">Mallorca<span class="text-brand-cyan">Canyons</span></span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-400">
          {t.footer.tagline}
        </p>
        <div class="mt-4 flex items-center gap-4 text-sm">
          <a href={localizePath('/contacto', lang)} class="flex items-center gap-1.5 text-slate-300 hover:text-brand-cyan">
            <Icon name="phone" class="w-4 h-4" />
            {t.nav.contacto}
          </a>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-slate-300 hover:text-brand-cyan">
            <Icon name="instagram" class="w-4 h-4" />
            {t.footer.instagram}
          </a>
        </div>
      </div>

      <div>
        <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-100">
          <Icon name="phone" class="w-4 h-4 text-brand-orange" />
          {t.footer.emergencias}
        </h3>
        <ul class="space-y-2 text-sm text-slate-400">
          <li class="flex items-center justify-between">
            <span>{t.footer.emergenciasGenerales}</span>
            <a href="tel:112" class="font-semibold text-brand-orange">112</a>
          </li>
          <li class="flex items-center justify-between">
            <span>{t.footer.greim}</span>
            <a href="tel:062" class="font-semibold text-brand-orange">062</a>
          </li>
          <li class="flex items-center justify-between">
            <span>{t.footer.ibsalut}</span>
            <a href="tel:061" class="font-semibold text-brand-orange">061</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-100">
          <Icon name="shield" class="w-4 h-4 text-brand-cyan" />
          {t.footer.disclaimerTitle}
        </h3>
        <p class="text-sm leading-relaxed text-slate-400">
          {t.footer.disclaimerPre}<a href={localizePath('/seguridad', lang)} class="text-brand-cyan hover:underline">{t.footer.disclaimerLink}</a>{t.footer.disclaimerPost}
        </p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-brand-border/80 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {t.footer.copyright}</p>
      <p>{t.footer.note}</p>
    </div>
  </div>
</footer>
