---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FichaTecnica from '../components/FichaTecnica.astro';
import TopoViewer from '../components/TopoViewer.astro';
import Gallery from '../components/Gallery.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getTorrenteMedia } from '../lib/images';
import { extractGrade, gradeAccent, primaryZona } from '../lib/torrente-helpers';
import { getDictionary } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/config';

interface Props {
  torrente: CollectionEntry<'torrentes'>;
  lang: Locale;
}

const { torrente, lang } = Astro.props;
const { data } = torrente;
const t = getDictionary(lang);
const { Content } = await render(torrente);
const media = getTorrenteMedia(data.slug);
const grade = extractGrade(data.dificultad);
const accent = gradeAccent(data.dificultad);
const zona = primaryZona(data.zona);
const whatsappMessage = t.cta.whatsappMessageTorrente.replace('{nombre}', data.nombre);

// Geo aproximado para los datos estructurados: primera coordenada "lat, lng (nota)" del frontmatter.
const firstCoord = Object.values(data.coordenadas)[0] ?? '';
const coordMatch = firstCoord.match(/-?\d+\.\d+/g);
const geo = coordMatch && coordMatch.length >= 2 ? { latitude: Number(coordMatch[0]), longitude: Number(coordMatch[1]) } : null;

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: data.nombre,
  description: `${data.nombre} — ${data.zona}. ${data.caracter}.`,
  touristType: 'Canyoning',
  ...(geo && { geo: { '@type': 'GeoCoordinates', ...geo } }),
};
---

<BaseLayout title={data.nombre} description={`${data.nombre} — ${data.zona}.`} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <section class="relative">
    <div class="relative h-[52vh] min-h-[380px] w-full overflow-hidden">
      {media.hero && (
        <Image
          src={media.hero}
          alt={data.nombre}
          width={1920}
          height={1080}
          loading="eager"
          class="h-full w-full object-cover"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-brand-bg via-brand-bg/40 to-brand-bg/10"></div>
    </div>

    <div class="relative z-10 mx-auto -mt-24 max-w-7xl px-4 pb-4 sm:px-6 lg:px-8">
      <a href={localizePath('/', lang)} class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-black/40 px-3 py-1.5 text-sm text-slate-200 backdrop-blur-sm transition hover:bg-black/60 hover:text-brand-cyan">
        <Icon name="chevron" class="w-4 h-4 rotate-90" />
        {t.detail.back}
      </a>

      <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-cyan">
        <Icon name="map-pin" class="w-4 h-4" />
        {zona}
      </p>
      <h1 class="mt-1 font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{data.nombre}</h1>

      <div class="mt-4 flex flex-wrap gap-2">
        <Badge
          icon="layers"
          label={data.dificultad}
          tone={accent === 'danger' ? 'danger' : accent === 'orange' ? 'orange' : 'cyan'}
        />
        <Badge icon="ruler" label={`${t.card.rapelMax} ${data.rapel_max} m`} />
        {data.tiempos.total && <Badge icon="clock" label={data.tiempos.total} />}
        <Badge icon="compass" label={data.caracter} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <FichaTecnica data={data} lang={lang} />

    <div class="mt-6 flex flex-wrap items-center gap-3 rounded-xl border border-brand-border bg-brand-surface/60 p-4">
      <Icon name="whatsapp" class="h-5 w-5 shrink-0 text-[#25D366]" />
      <p class="text-sm text-slate-300">{t.cta.consultarTorrente}</p>
      <WhatsAppButton message={whatsappMessage} label={t.contacto.whatsappCta} variant="inline" class="ml-auto" />
    </div>

    <article class="prose-torrent mt-12 max-w-3xl">
      <Content />
    </article>

    {media.topos.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 flex items-center gap-2 font-display text-xl font-semibold text-white">
          <Icon name="layers" class="w-5 h-5 text-brand-cyan" />
          {media.topos.length > 1 ? t.topo.titleMany : t.topo.titleOne}
        </h2>
        <TopoViewer topos={media.topos} alt={data.nombre} id={`topo-${data.slug}`} tapToZoom={t.topo.tapToZoom} />
      </div>
    )}

    {media.gallery.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 flex items-center gap-2 font-display text-xl font-semibold text-white">
          <Icon name="camera" class="w-5 h-5 text-brand-cyan" />
          {t.gallery.title}
        </h2>
        <Gallery images={media.gallery} alt={data.nombre} id={`gallery-${data.slug}`} />
      </div>
    )}
  </section>
</BaseLayout>
